[ext_resource type="PackedScene" uid="uid://ca1q6lqu5kabe" path="res://assets/thirdparty/Sci-Fi Essentials Kit[Standard]/glTF/Enemy_QuadShell.gltf" id="1_model"]

[node name="RusherModel" type="Node3D"]

; 180 deg about Y: the QuadShell model faces +Z, but EnemyBase._face uses look_at
