[gd_scene load_steps=2 format=3 uid="uid://crisenrusher01"]

; Melee Rusher = custom fal.ai Hive-thrall creature (T-0044). Wrapper for
; EnemyBase._apply_external_model (loads characters/<type>.{glb,tscn}; .glb is
; checked first, so keeping the model in assets/generated/enemies/ and referencing
; it from this .tscn lets us apply the facing flip + scale here). Teal-soulfire
; Hive art direction; rigged idle + walk (Meshy). Faces -Z, ~1.97 m.

[ext_resource type="PackedScene" uid="uid://bh1de4os64pyd" path="res://assets/generated/enemies/rusher.glb" id="1_model"]

[node name="RusherModel" type="Node3D"]

; 180 deg about Y: the Meshy model faces +Z, but EnemyBase._face uses look_at
; (points the node's -Z at the player), so unflipped it chases you facing backwards.
[node name="Model" parent="." instance=ExtResource("1_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
