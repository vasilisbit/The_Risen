[gd_scene format=3 uid="uid://cr1s3nautorifle01"]

; Worked-example Auto Rifle model, built from primitive boxes so the external
; weapon-model pipeline (weapon_viewmodel.gd -> _load_external) has something
; real to load. Replace with a CC0/imported glTF (e.g. Kenney Blaster Kit)
; named auto_rifle.glb and this .tscn is superseded automatically.
; Barrel faces -Z (forward), grip toward -Y, ~0.4 m long.

[sub_resource type="StandardMaterial3D" id="Metal"]
albedo_color = Color(0.11, 0.11, 0.13, 1)
metallic = 0.7
roughness = 0.4

[sub_resource type="StandardMaterial3D" id="Accent"]
albedo_color = Color(0.15, 0.35, 0.7, 1)
metallic = 0.2
roughness = 0.5
emission_enabled = true
emission = Color(0.12, 0.32, 0.85, 1)
emission_energy_multiplier = 1.0

[sub_resource type="BoxMesh" id="Receiver"]
material = SubResource("Metal")
size = Vector3(0.12, 0.14, 0.4)

[sub_resource type="BoxMesh" id="Barrel"]
material = SubResource("Metal")
size = Vector3(0.05, 0.05, 0.34)

