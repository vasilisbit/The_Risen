config_version=5

[application]

config/name="The Risen"
config/description="Mission-based third-person looter shooter. A Guardian fights across Earth, Mars, and Venus to recover critical technology."
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="forward_plus"
